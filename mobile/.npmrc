# React Native's Android build needs a flat node_modules.
#
# settings.gradle resolves the React Native gradle plugin by path
# (../node_modules/@react-native/gradle-plugin), and autolinking resolves
# every native module the same way. pnpm's default layout only links a
# package's *direct* dependencies, so those paths do not exist and the
# Android build fails at the very first step.
#
# node-linker=hoisted gives the flat layout npm/yarn produce, which is what
# the React Native toolchain expects. Verified: without this, `pnpm android`
# cannot even configure Gradle.
node-linker=hoisted
